{
  "name": "konukdefteri-server",
  "version": "1.0.0",
  "private": true,
  "description": "KonukDefteri API sunucusu ve KBS bildirim kuyruğu",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:geri": "knex migrate:rollback --knexfile knexfile.js",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.2",
    "express": "^4.18.1",
    "express-rate-limit": "^6.5.2",
    "helmet": "^5.1.0",
    "joi": "^17.6.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^2.3.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.2",
    "soap": "^0.45.0",
    "sqlite3": "^5.1.2",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^28.1.3",
    "nodemon": "^2.0.19",
    "supertest": "^6.2.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/ortam.js"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../.env"
    ],
    "ext": "js,json,wsdl"
  }
}
