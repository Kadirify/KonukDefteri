# Bu dosyayı .env adıyla kopyalayın. .env git'e girmez.

# API portu. Arayüz geliştirmede 3000'den bu porta proxy yapar.
PORT=3001

# Oturum imzası. Uzun, rastgele bir metin. "npm run anahtar" öneri üretir.
JWT_GIZLI=

# TC kimlik numaralarını şifrelemek için 64 haneli hex anahtar. "npm run anahtar" ile üretin.
# Bu anahtar kaybolursa kayıtlı TC numaraları bir daha okunamaz, yedeğini alın.
SIFRE_ANAHTARI=

# İlk kurulumda "yonetici" kullanıcısına verilecek parola. İlk girişte değiştirilmesi istenir.
YONETICI_PAROLA=konuk2022

# Veritabanı ve log klasörü. Boşsa server/data kullanılır.
VERI_KLASORU=

